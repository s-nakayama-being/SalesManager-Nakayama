{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
